  "funding": {
    "type": "individual",
    "url": "https://www.buymeacoffee.com/subodhkc"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
