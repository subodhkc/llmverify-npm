{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/subodhkc/llmverify-npm/schema/verify-result.schema.json",
  "title": "VerifyResult",
  "description": "JSON schema for llmverify verify() output — result contract version 1.0. Engine-specific results (hallucination, consistency, json, csm6) are OPTIONAL and present only when the corresponding engine ran; see notChecked for engines that produced no result. Semantics: a risk level/score is a heuristic risk signal, not proof of correctness; entries in notChecked mean the check did NOT run — never treat absent analysis as a pass.",
  "type": "object",
  "required": ["schemaVersion", "risk", "meta", "limitations", "notChecked"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Result contract version. Independent of the package version."
    },
    "risk": {
      "type": "object",
      "description": "Overall risk assessment — a heuristic risk signal, not a factual guarantee",
      "required": ["overall", "level", "components", "blockers", "action", "confidence", "interpretation"],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Weighted risk score (0-1)"
        },
        "level": {
          "type": "string",
          "enum": ["low", "moderate", "high", "critical"]
        },
        "components": {
          "type": "object",
          "required": ["hallucination", "consistency", "csm6"],
          "properties": {
            "hallucination": { "type": "number", "minimum": 0, "maximum": 1 },
            "consistency": { "type": "number", "minimum": 0, "maximum": 1 },
            "csm6": { "type": "number", "minimum": 0, "maximum": 1 },
            "json": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "action": {
          "type": "string",
          "enum": ["allow", "review", "block"],
          "description": "Recommended action within evaluated scope and available evidence — 'allow' is not a guarantee of safety"
        },
        "confidence": { "$ref": "#/definitions/ConfidenceScore" },
        "interpretation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hallucination": {
      "type": "object",
      "description": "Hallucination RISK SIGNALS (pattern-based). Present only when the hallucination engine ran. Risk signals are not confirmed factual errors.",
      "required": ["claims", "suspiciousClaims", "riskScore", "confidence", "riskIndicators", "limitations", "methodology"],
      "properties": {
        "claims": {
          "type": "array",
          "items": { "$ref": "#/definitions/Claim" }
        },
        "suspiciousClaims": {
          "type": "array",
          "items": { "$ref": "#/definitions/Claim" }
        },
        "riskScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "$ref": "#/definitions/ConfidenceScore" },
        "riskIndicators": {
          "type": "object",
          "required": ["lackOfSpecificity", "missingCitations", "vagueLanguage", "contradictionSignals"],
          "properties": {
            "lackOfSpecificity": { "type": "number" },
            "missingCitations": { "type": "number" },
            "vagueLanguage": { "type": "number" },
            "contradictionSignals": { "type": "number" }
          },
          "additionalProperties": false
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "methodology": { "type": "string" }
      },
      "additionalProperties": false
    },
    "consistency": {
      "type": "object",
      "description": "Internal consistency analysis. Present only when the consistency engine ran.",
      "required": ["sections", "avgSimilarity", "stable", "drift", "contradictions", "confidence", "limitations", "methodology"],
      "properties": {
        "sections": { "type": "array", "items": { "type": "string" } },
        "avgSimilarity": { "type": "number" },
        "similarityMatrix": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "number" } }
        },
        "stable": { "type": "boolean" },
        "drift": { "type": "boolean" },
        "contradictions": {
          "type": "array",
          "items": { "$ref": "#/definitions/Contradiction" }
        },
        "confidence": { "$ref": "#/definitions/ConfidenceScore" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "methodology": { "type": "string" }
      },
      "additionalProperties": false
    },
    "json": {
      "type": "object",
      "description": "JSON validation result. Present only when context.isJSON was set and the JSON validator ran.",
      "required": ["valid", "parsed", "schemaValid", "schemaErrors", "repaired", "structure", "limitations", "methodology"],
      "properties": {
        "valid": { "type": "boolean" },
        "parsed": {},
        "schema": {},
        "schemaValid": { "type": "boolean" },
        "schemaErrors": { "type": "array", "items": { "type": "string" } },
        "repaired": { "type": "boolean" },
        "repairMethod": { "type": "string" },
        "structure": {
          "type": "object",
          "required": ["depth", "keyCount", "issues"],
          "properties": {
            "depth": { "type": "number" },
            "keyCount": { "type": "number" },
            "issues": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "methodology": { "type": "string" }
      },
      "additionalProperties": false
    },
    "csm6": {
      "type": "object",
      "description": "CSM6 baseline checks (prompt injection, PII, harmful content). Present only when the CSM6 engine ran. NO findings observed is not proof of safety.",
      "required": ["findings", "summary", "riskScore", "passed", "profile", "checksPerformed", "limitations", "methodology"],
      "properties": {
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/Finding" }
        },
        "summary": {
          "type": "object",
          "required": ["total", "bySeverity", "byCategory"],
          "properties": {
            "total": { "type": "number" },
            "bySeverity": {
              "type": "object",
              "properties": {
                "info": { "type": "number" },
                "low": { "type": "number" },
                "medium": { "type": "number" },
                "high": { "type": "number" },
                "critical": { "type": "number" }
              },
              "additionalProperties": false
            },
            "byCategory": {
              "type": "object",
              "properties": {
                "security": { "type": "number" },
                "privacy": { "type": "number" },
                "safety": { "type": "number" },
                "fairness": { "type": "number" },
                "reliability": { "type": "number" },
                "governance": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "riskScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed": {
          "type": "boolean",
          "description": "True when no high/critical findings — means 'no blocking findings observed', not 'verified safe'"
        },
        "profile": { "type": "string" },
        "checksPerformed": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "methodology": { "type": "string" }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["verification_id", "timestamp", "latency_ms", "version", "tier", "enginesUsed"],
      "properties": {
        "verification_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "latency_ms": { "type": "number", "minimum": 0 },
        "version": { "type": "string", "description": "llmverify package version" },
        "tier": { "type": "string", "enum": ["free", "starter", "pro", "business"] },
        "enginesUsed": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known limitations of this verification — always present, may be empty but is typically non-empty"
    },
    "notChecked": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Engines that produced NO result (disabled, skipped, or not applicable). NOT_CHECKED is never a pass."
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Usage-limit warnings (present only when applicable)"
    },
    "audit": {
      "type": "object",
      "description": "Audit persistence receipt for this verification (v1.7+). Describes what actually happened to the audit write.",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PERSISTED", "DISABLED", "FAILED", "NOT_ATTEMPTED"]
        },
        "filePath": { "type": "string" },
        "entryDigest": { "type": "string" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ConfidenceScore": {
      "type": "object",
      "description": "Heuristic confidence — method 'heuristic' is not a calibrated empirical probability",
      "required": ["value", "interval", "method"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "interval": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "method": {
          "type": "string",
          "enum": ["heuristic", "bootstrap", "bayesian", "empirical"]
        },
        "factors": {
          "type": "object",
          "properties": {
            "patternStrength": { "type": "number" },
            "contextClarity": { "type": "number" },
            "historicalAccuracy": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "span": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "textSample": { "type": "string" },
        "pattern": { "type": "string" },
        "context": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "required": ["id", "category", "severity", "surface", "message", "recommendation", "confidence", "limitations", "methodology"],
      "properties": {
        "id": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["security", "privacy", "safety", "fairness", "reliability", "governance"]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "surface": {
          "type": "string",
          "enum": ["input", "output", "behavior"]
        },
        "message": { "type": "string" },
        "recommendation": { "type": "string" },
        "evidence": { "$ref": "#/definitions/Evidence" },
        "confidence": { "$ref": "#/definitions/ConfidenceScore" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "methodology": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "required": ["text", "span", "type", "verifiable", "riskIndicators", "confidence", "limitations"],
      "properties": {
        "text": { "type": "string" },
        "span": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "type": {
          "type": "string",
          "enum": ["factual", "opinion", "instruction", "metadata"]
        },
        "verifiable": { "type": "boolean" },
        "riskIndicators": {
          "type": "object",
          "required": ["lackOfSpecificity", "missingCitation", "vagueLanguage", "contradictionSignal"],
          "properties": {
            "lackOfSpecificity": { "type": "number" },
            "missingCitation": { "type": "boolean" },
            "vagueLanguage": { "type": "boolean" },
            "contradictionSignal": { "type": "boolean" },
            "fabricatedStatRisk": { "type": "number" },
            "overconfidenceRisk": { "type": "number" },
            "fakeAuthorityRisk": { "type": "number" },
            "combinedRisk": { "type": "number" }
          },
          "additionalProperties": false
        },
        "confidence": { "$ref": "#/definitions/ConfidenceScore" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "Contradiction": {
      "type": "object",
      "required": ["section1", "section2", "claim1", "claim2", "type", "confidence"],
      "properties": {
        "section1": { "type": "number" },
        "section2": { "type": "number" },
        "claim1": { "type": "string" },
        "claim2": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["factual", "temporal", "logical", "sentiment_drift", "style_drift", "numerical"]
        },
        "confidence": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
